# Copy to ~/.config/restic/restic.env and fill in (never commit).
#   cp ~/dotfiles/config/restic/restic.env.example ~/.config/restic/restic.env
#   chmod 600 ~/.config/restic/restic.env
#
# Use KEY=value (no "export") so both work:
#   source ~/.config/restic/restic.env
#   systemd EnvironmentFile=...
#
# Then: source ~/.config/restic/restic.env && ~/dotfiles/scripts/restic-backup.sh

# --- Repository (choose ONE) ---

# A) Backblaze B2 native (recommended)
# Create bucket + Application Key: https://secure.backblaze.com/
# Docs: https://www.backblaze.com/docs/cloud-storage-create-and-manage-app-keys
#
# "Account ID" is obsolete naming. For restic:
#   B2_ACCOUNT_ID  = keyID          (of the Application Key you create)
#   B2_ACCOUNT_KEY = applicationKey (shown only once — save it)
# Prefer a scoped App Key (one bucket, Read and Write), not the Master Key.
B2_ACCOUNT_ID=003xxxxxxxxxxxxxxx
B2_ACCOUNT_KEY=K000xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESTIC_REPOSITORY=b2:BUCKET_NAME:restic-home

# B) Local external disk
# RESTIC_REPOSITORY=/media/BACKUP/restic-home-local

# --- Password (pick one) ---
RESTIC_PASSWORD=CHANGE_ME_STORE_IN_PASSWORD_MANAGER
# RESTIC_PASSWORD_FILE=/home/daniel/.config/restic/password

# --- Optional overrides ---
# RESTIC_EXCLUDE_FILE=/home/daniel/.config/restic/exclude.txt
# RESTIC_KEEP_DAILY=7
# RESTIC_KEEP_WEEKLY=4
# RESTIC_KEEP_MONTHLY=6
